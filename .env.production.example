# Copie para .env.production no VPS; no Railway, use Variables seguras.
# Nunca copie .env de desenvolvimento para produção nem versione este arquivo preenchido.
NODE_ENV=production
PORT=3000
DATA_DIR=/data
APP_DOMAIN=
TLS_CONTACT_EMAIL=
APP_ORIGIN=
OPERATOR_NAME="Vinicius Antunes e Silva"
OPERATOR_TAX_ID=
# Localização informada: São Paulo. Complete a localidade/referência real; não invente rua/número.
OPERATOR_ADDRESS=
SUPPORT_EMAIL=vinitudotwo@gmail.com
PRIVACY_EMAIL=vinitudotwo@gmail.com
SUPPORT_DISCORD_URL=
ADMIN_EMAILS=
# Cada chave abaixo deve ser gerada separadamente (openssl rand -hex 32).
APP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
NEXORA_ADMIN_TOKEN=
# Primeiro: false. Apenas LAUNCH_TEST_EMAIL poderá testar live após preflight.
PUBLIC_CHECKOUT_ENABLED=false
LAUNCH_TEST_EMAIL=vinitudotwo@gmail.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
PROVISIONER_URL=
PROVISIONER_TOKEN=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=platform
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# VPS Compose fixa o IP do Caddy. Railway: só configure proxies realmente verificados.
TRUSTED_PROXIES=
