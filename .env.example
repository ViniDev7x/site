# Opcional. Copie para .env; nunca versione .env nem cole segredos no chat.
# A demonstração funciona sem estas variáveis.
# Somente Stripe test mode (sk_test_...) é aceito no ambiente de desenvolvimento.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública HTTPS do seu ambiente de teste (sem barra final).
APP_ORIGIN=
# Opcional: token forte para administração. Vazio gera .local/admin-token.
NEXORA_ADMIN_TOKEN=
